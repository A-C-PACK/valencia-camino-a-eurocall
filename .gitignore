# Godot's import cache: rebuilt automatically when the project is opened
game/.godot/

# Build outputs: regenerate with tools/web_build.py and tools/artifact_build.py
web/
artifact/

# WAV masters for the voices (the game ships the Ogg files in game/audio/voice/).
# Kept out of git for size; regenerate with tools/tts_generate.py.
audio_src/

# Demo clips and voice auditions
samples/

# Run logs and Python caches
tools/*.log
__pycache__/
*.pyc

# This machine's own paths and hosts (see tools/local.example.*)
tools/local.json
tools/local.cmd
